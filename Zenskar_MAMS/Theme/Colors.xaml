<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark Theme Base Colors -->
    <Color x:Key="PrimaryDarkColor">#0A0E1A</Color>
    <Color x:Key="SecondaryDarkColor">#151928</Color>
    <Color x:Key="BackgroundColor">#1E2233</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="AccentPurple">#9C3FE4</Color>
    <Color x:Key="AccentPink">#FF3366</Color>
    <Color x:Key="AccentBlue">#3F8CFF</Color>
    <Color x:Key="AccentCyan">#00E5FF</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#B8B9BD</Color>
    <Color x:Key="TextMutedColor">#6C7080</Color>
    
    <!-- Surface Colors -->
    <Color x:Key="SurfaceColor">#252A3D</Color>
    <Color x:Key="SurfaceLightColor">#2A305F</Color>
    <Color x:Key="SurfaceDarkColor">#1A1E2D</Color>
    
    <!-- State Colors -->
    <Color x:Key="SuccessColor">#C4DFAA</Color>
    <Color x:Key="WarningColor">#FFD740</Color>
    <Color x:Key="WarningColor1">#FAF3A0</Color>
    <Color x:Key="ErrorColor">#F2A8A8</Color>

    <!-- Gradient Stops -->
    <GradientStop x:Key="GradientStart" Color="#3F8CFF" Offset="0"/>
    <GradientStop x:Key="GradientMiddle" Color="#9C3FE4" Offset="0.5"/>
    <GradientStop x:Key="GradientEnd" Color="#FF3366" Offset="1"/>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush1" Color="{StaticResource WarningColor1}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryDarkColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource SurfaceLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    
    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentPurple}" Offset="0.5"/>
        <GradientStop Color="{StaticResource AccentPink}" Offset="1"/>
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{StaticResource AccentCyan}" Offset="0"/>
        <GradientStop Color="{StaticResource AccentBlue}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Effects -->
    <DropShadowEffect x:Key="ModernShadowEffect"
                      BlurRadius="20"
                      ShadowDepth="0"
                      Color="#000000"
                      Opacity="0.2"/>
</ResourceDictionary>