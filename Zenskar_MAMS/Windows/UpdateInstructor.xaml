<Window x:Class="Zenskar_MAMS.Windows.UpdateInstructor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Instructor - Zenskar MAMS" 
        Height="400" 
        Width="500" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="{StaticResource SecondaryBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" 
                   Text="Update Instructor" 
                   FontSize="20" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Batch ID Input -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="Batch ID" 
                       FontSize="14" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="TxtBatchId"
                     Height="45"
                     Padding="10"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     Background="{StaticResource PrimaryBackgroundBrush}"
                     BorderBrush="{StaticResource TextSecondaryBrush}"
                     BorderThickness="1"
                     FontSize="13"/>
        </StackPanel>

        <!-- Instructor Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,15">
            <TextBlock Text="Select New Instructor" 
                       FontSize="14" 
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbInstructor"
                      Height="40"
                      Padding="10"
                      Foreground="{StaticResource SecondaryBackgroundBrush}"
                      Background="{StaticResource PrimaryBackgroundBrush}"
                      BorderBrush="{StaticResource TextSecondaryBrush}"
                      BorderThickness="1"
                      FontSize="13"
                      DisplayMemberPath="User_Name"
                      SelectedValuePath="User_Name"/>
        </StackPanel>

        <!-- Info Message -->
        <StackPanel Grid.Row="3" Margin="0,0,0,15">
            <TextBlock Text="Note: This will update the instructor for all students in the selected batch." 
                       FontSize="12" 
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Spacer -->
        <StackPanel Grid.Row="4"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="BtnSave"
                    Content="Save"
                    Click="BtnSave_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Width="100"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnCancel"
                    Content="Cancel"
                    Click="BtnCancel_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>