<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Password" Height="400" Width="400" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Change Password" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <TextBlock Text="Login ID"/>
            <TextBox x:Name="TxtLoginId"/>

            <TextBlock Text="Current Password" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PwdCurrent"/>

            <TextBlock Text="New Password" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PwdNew"/>

            <TextBlock Text="Confirm Password" Margin="0,10,0,0"/>
            <PasswordBox x:Name="PwdConfirm"/>

            <TextBlock x:Name="TxtError" Foreground="Red" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Submit" Width="80" Click="BtnSubmit_Click"/>
        </StackPanel>
    </Grid>
</Window>