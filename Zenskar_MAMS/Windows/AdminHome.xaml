<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.AdminHome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Dashboard - Zenskar MAMS" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid Margin="0,0,0,-214">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
        Background="{StaticResource SurfaceBrush}"
        Effect="{StaticResource ModernShadowEffect}"
        Margin="30,25,30,0"
        Height="80">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Admin Dashboard"
                   Style="{StaticResource ModernHeaderStyle}"
                   VerticalAlignment="Center"/>

                <TextBlock x:Name="ExamDueCountText"
                   Style="{StaticResource ModernHeaderStyle}"
                   Text="Exam Due Batches: 0"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right"
                   Margin="0,0,20,0"
                   MouseLeftButtonDown="CallLoadExamDueBatchs" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="30,80,30,185">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Dashboard Cards -->
            <WrapPanel Grid.Row="0" 
                      HorizontalAlignment="Center"
                      Margin="0,41,0,226" Grid.RowSpan="2">

                <!-- Students List Card -->
                <Border Width="300" 
                        Height="200"
                        Margin="15"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" 
                                ShadowDepth="0"
                                Color="{StaticResource AccentPink}"
                                Opacity="0.2"/>
                    </Border.Effect>
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Click="BtnStudentsList_Click"
                            Background="Transparent"
                            Width="300"
                            Height="200">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Icon -->
                            <Path Grid.Row="0"
                                  Data="M12,5A3.5,3.5 0 0,0 8.5,8.5A3.5,3.5 0 0,0 12,12A3.5,3.5 0 0,0 15.5,8.5A3.5,3.5 0 0,0 12,5M12,7A1.5,1.5 0 0,1 13.5,8.5A1.5,1.5 0 0,1 12,10A1.5,1.5 0 0,1 10.5,8.5A1.5,1.5 0 0,1 12,7M5.5,8A2.5,2.5 0 0,0 3,10.5C3,11.44 3.53,12.25 4.29,12.68C4.65,12.88 5.06,13 5.5,13C5.94,13 6.35,12.88 6.71,12.68C7.47,12.25 8,11.44 8,10.5A2.5,2.5 0 0,0 5.5,8M19,2H5C3.89,2 3,2.89 3,4V18A2,2 0 0,0 5,20H9L12,23L15,20H19A2,2 0 0,0 21,18V4C21,2.89 20.1,2 19,2Z"
                                  Width="50"
                                  Height="50"
                                  Fill="{StaticResource AccentGradientBrush}"
                                  Stretch="Uniform"
                                  Margin="0,20"/>

                            <!-- Text -->
                            <StackPanel Grid.Row="1"
                                      VerticalAlignment="Center">
                                <TextBlock Text="Students List"
                                         FontSize="24"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage student records"
                                         FontSize="14"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         HorizontalAlignment="Center"
                                         Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>

                <!-- Requests Card -->
                <Border Width="300" 
                        Height="200"
                        Margin="15"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" 
                                        ShadowDepth="0"
                                        Color="{StaticResource AccentPink}"
                                        Opacity="0.2"/>
                    </Border.Effect>
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Click="BtnRequests_Click"
                            Background="Transparent"
                            Width="300"
                            Height="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Icon -->
                            <Path Grid.Row="0"
                                  Data="M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21Z"
                                  Width="50"
                                  Height="50"
                                  Fill="{StaticResource PrimaryGradientBrush}"
                                  Stretch="Uniform"
                                  Margin="0,20"/>

                            <!-- Text -->
                            <StackPanel Grid.Row="1"
                                      VerticalAlignment="Center">
                                <TextBlock Text="Requests"
                                         FontSize="24"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage pending requests"
                                         FontSize="14"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         HorizontalAlignment="Center"
                                         Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>

                <!-- User Management Card -->
                <Border Width="300" 
                        Height="200"
                        Margin="15"
                        Background="{StaticResource SurfaceBrush}"
                        CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" 
                                        ShadowDepth="0"
                                        Color="{StaticResource AccentPink}"
                                        Opacity="0.2"/>
                    </Border.Effect>
                    <Button Style="{StaticResource ModernButtonStyle}"
                            Click="BtnManageUsers_Click"
                            Background="Transparent"
                            Width="300"
                            Height="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Icon -->
                            <Path Grid.Row="0"
                                  Data="M16 17V19H2V17S2 13 9 13 16 17 16 17M12.5 7.5A3.5 3.5 0 1 0 9 11A3.5 3.5 0 0 0 12.5 7.5M15.94 13A5.32 5.32 0 0 1 18 17V19H22V17S22 13.37 15.94 13M15 4A3.39 3.39 0 0 0 13.07 4.59A5 5 0 0 1 13.07 10.41A3.39 3.39 0 0 0 15 11A3.5 3.5 0 0 0 15 4Z"
                                  Width="50"
                                  Height="50"
                                  Fill="{StaticResource AccentGradientBrush}"
                                  Stretch="Uniform"
                                  Margin="0,20"/>

                            <!-- Text -->
                            <StackPanel Grid.Row="1"
                                      VerticalAlignment="Center">
                                <TextBlock Text="User Management"
                                         FontSize="24"
                                         FontWeight="SemiBold"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage system users"
                                         FontSize="14"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         HorizontalAlignment="Center"
                                         Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>
                <!-- Attendance Card -->
                <!--<Border Width="300" 
        Height="200"
        Margin="350,5,10,10"
        Background="{StaticResource SurfaceBrush}"
        CornerRadius="15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" 
                        ShadowDepth="0"
                        Color="{StaticResource AccentPink}"
                        Opacity="0.2"/>
                    </Border.Effect>
                    <Button Style="{StaticResource ModernButtonStyle}"
            Click="BtnAttendance_Click"
            Background="Transparent"
            Width="300"
            Height="200">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            --><!-- Icon --><!--
                            <Path Grid.Row="0"
                                  
                  Data="M9 2A1 1 0 0 0 8 3V4H6A2 2 0 0 0 4 6V20A2 2 0 0 0 6 22H18A2 2 0 0 0 20 20V6A2 2 0 0 0 18 4H16V3A1 1 0 0 0 15 2H9M9 4H15V6H9V4M9 10H11V12H9V10M9 14H11V16H9V14M13 10H17V12H13V10M13 14H17V16H13V14Z"
                  Width="50"
                  Height="50"
                  Fill="{StaticResource AccentGradientBrush}"
                  Stretch="Uniform"
                  Margin="0,20"/>

                            --><!-- Text --><!--
                            <StackPanel Grid.Row="1"
                      VerticalAlignment="Center">
                                <TextBlock Text="Attendance"
                         FontSize="24"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Manage Attendance"
                         FontSize="14"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         HorizontalAlignment="Center"
                         Margin="0,5"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>-->
            </WrapPanel>
        </Grid>
    </Grid>
</Window>