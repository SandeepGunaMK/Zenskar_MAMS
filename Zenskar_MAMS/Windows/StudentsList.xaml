<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.StudentsList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Students List - Zenskar MAMS" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SecondaryBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" 
                    Background="{StaticResource PrimaryBackgroundBrush}"
                    Margin="0">
            <TextBlock Text="Students List"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="24"
                      Margin="30,10"/>
            <Button x:Name="BtnBack"
                    Content="Back"
                    Click="BtnBack_Click"
                    Margin="1000,-40,20,10"
                    Style="{StaticResource ModernButtonStyle}" Width="30"/>
        </StackPanel>

        <!-- Search/Filter Section -->
        <Expander Grid.Row="1" 
                  Header="Search Filters" Foreground="{StaticResource TextSecondaryBrush}"
                  Margin="10"
                  IsExpanded="True">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Row 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Student Name"/>
                    <TextBox x:Name="TxtNameFilter" Margin="0,5"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Age"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="CmbAgeOperator" Width="60" Margin="0,5,5,5" >
                            <ComboBoxItem Content="="/>
                            <ComboBoxItem Content="&gt;"/>
                            <ComboBoxItem Content="&lt;"/>
                        </ComboBox>
                        <TextBox x:Name="TxtAgeFilter" Width="100"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Gender"/>
                    <ComboBox x:Name="CmbGenderFilter" Margin="0,5">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Male"/>
                        <ComboBoxItem Content="Female"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Location"/>
                    <TextBox x:Name="TxtLocationFilter" Margin="0,5"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5" >
                    <TextBlock Text="Belt"/>
                    <ComboBox x:Name="CmbBeltFilter" Margin="0,5">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="White"/>
                        <ComboBoxItem Content="White Senior"/>
                        <ComboBoxItem Content="Yellow"/>
                        <ComboBoxItem Content="Blue"/>
                        <ComboBoxItem Content="Blue Senior"/>
                        <ComboBoxItem Content="Green"/>
                        <ComboBoxItem Content="Green Senior"/>
                        <ComboBoxItem Content="Brown"/>
                        <ComboBoxItem Content="Brown Senior"/>
                        <ComboBoxItem Content="Black"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                    <TextBlock Text="Status"/>
                    <ComboBox x:Name="CmbStatusFilter" Margin="0,5">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Stopped"/>
                    </ComboBox>
                </StackPanel>

                <!-- Filter Logic -->
                <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" 
                          Margin="10,5" 
                          VerticalAlignment="Center">
                    <RadioButton x:Name="RbAnd" 
                               Content="AND" 
                               IsChecked="True"
                               Margin="0,0,0,5"/>
                    <RadioButton x:Name="RbOr" 
                               Content="OR"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" 
                          Grid.Column="0" 
                          Grid.ColumnSpan="4" 
                          Orientation="Horizontal"
                          HorizontalAlignment="Right"
                          Margin="5">
                    <Button Content="Apply Filters"
                            Click="BtnApplyFilters_Click"
                            Style="{StaticResource ModernButtonStyle}"
                            Margin="0,0,10,0"/>
                    <Button Content="Clear Filters"
                            Click="BtnClearFilters_Click"
                            Style="{StaticResource ModernButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Students DataGrid -->
        <DataGrid x:Name="StudentsGrid" 
                  Grid.Row="2"
                  Margin="10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="StudentsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="60"/>
                <DataGridTextColumn Header="Gender" Binding="{Binding Gender}" Width="80"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                <DataGridTextColumn Header="Belt" Binding="{Binding Belt}" Width="100"/>
                <DataGridTextColumn Header="Instructor" Binding="{Binding InstructorName}" Width="*"/>
                <DataGridTextColumn Header="Master" Binding="{Binding MasterName}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StudentStatus}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="Add New Student"
                    Click="BtnAddStudent_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="View Details"
                    Click="BtnViewDetails_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="Stop Student"
                    Click="BtnStopStudent_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnDeleteStudent"
                    Content="Delete Student"
                    Click="BtnDeleteStudent_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>