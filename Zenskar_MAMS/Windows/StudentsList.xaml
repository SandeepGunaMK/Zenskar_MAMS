<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.StudentsList"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Students List - Zenskar MAMS" 
        Height="700" 
        Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SecondaryBackgroundBrush}">
    <Window.Resources>
        <!-- DataGrid Column Header Template -->
        <DataTemplate x:Key="DataGridFilterHeaderTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding}"
                          VerticalAlignment="Center"/>
                <!--<Button Grid.Column="1"
                        Content="▿"
                        Width="18"
                        Margin="5,0,0,0"                        
                        Click="FilterButton_Click"
                        Tag="{Binding}"/>-->
                
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" 
                    Background="{StaticResource PrimaryBackgroundBrush}"
                    Margin="0">
            <TextBlock Text="Students List"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="24"
                      Margin="30,10"/>
            <Button x:Name="BtnBack"
                    Content="Back"
                    Click="BtnBack_Click"
                    Margin="1000,-40,20,10"
                    Style="{StaticResource ModernButtonStyle}" Width="100"/>
            <Button x:Name="ClearFilters"
                    Content="Clear Filters"
                    Click="ClearFilters_BtnClick"
                    Margin="750,-40,20,10"
                    Style="{StaticResource ModernButtonStyle}" Width="100"/>
        </StackPanel>

        <!-- Batch Filters Expander -->
        <Expander Grid.Row="1" 
                  Header="Batch Filters" Foreground="{StaticResource TextSecondaryBrush}"
                  Margin="10"
                  IsExpanded="False">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Row 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Location"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,-25" />
                    <ComboBox x:Name="Location"
                                Width="248"
                                Margin="10,5,5,5"
                                Foreground="{StaticResource SecondaryBackgroundBrush}"
                                ItemsSource="{Binding Location_BF}"
                                DisplayMemberPath="Location"
                                SelectedValuePath="Location"
                                SelectedValue="{Binding SelectedLocation, Mode=TwoWay}"
                                SelectionChanged="BatchFilterSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Batch"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,-25" />
                    <ComboBox x:Name="Batch"
                            Width="248"
                            Margin="10,5,5,5"
                            Foreground="{StaticResource SecondaryBackgroundBrush}"
                            ItemsSource="{Binding Batch_BF}"
                            DisplayMemberPath="Batch"
                            SelectedValuePath="Batch"
                            SelectedValue="{Binding SelectedBatch, Mode=TwoWay}"
                            SelectionChanged="BatchFilterSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Status"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,-25" />
                    <ComboBox x:Name="Status"
                                Width="248"
                                Margin="10,5,5,5"
                                Foreground="{StaticResource SecondaryBackgroundBrush}"
                                ItemsSource="{Binding Status_BF}"
                                DisplayMemberPath="Batch"
                                SelectedValuePath="Batch"
                                SelectedValue="{Binding SelectedStatus, Mode=TwoWay}"
                                SelectionChanged="BatchFilterSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Instructor"
                               FontSize="15"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,-25" />
                    <ComboBox x:Name="Instructor"
                               Width="248"
                               Margin="10,5,5,5"
                               Foreground="{StaticResource SecondaryBackgroundBrush}"
                               ItemsSource="{Binding Instructor_BF}"
                               DisplayMemberPath="Batch"
                               SelectedValuePath="Batch"
                               SelectedValue="{Binding SelectedInstructor, Mode=TwoWay}"
                               SelectionChanged="BatchFilterSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <TextBlock Text="Master"
                                FontSize="15"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,-25" />
                    <ComboBox x:Name="Master"
                                Width="248"
                                Margin="10,5,5,5"
                                Foreground="{StaticResource SecondaryBackgroundBrush}"
                                ItemsSource="{Binding Master_BF}"
                                DisplayMemberPath="Batch"
                                SelectedValuePath="Batch"
                                SelectedValue="{Binding SelectedMaster, Mode=TwoWay}"
                                SelectionChanged="BatchFilterSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                    <TextBlock Text="Gender"
                                    FontSize="15"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    Margin="0,0,0,-25" />
                    <ComboBox x:Name="Gender"
                                    Width="248"
                                    Margin="10,5,5,5"
                                    Foreground="{StaticResource SecondaryBackgroundBrush}"
                                    ItemsSource="{Binding Gender_BF}"
                                    DisplayMemberPath="Batch"
                                    SelectedValuePath="Batch"
                                    SelectedValue="{Binding SelectedGender, Mode=TwoWay}"
                                    SelectionChanged="BatchFilterSelected"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                    <TextBlock Text="Age"
                                FontSize="15"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,-25" />
                    <ComboBox x:Name="Age" Width="70"
                                Margin="-169,5,5,5"
                                Foreground="{StaticResource SecondaryBackgroundBrush}"                    
                                SelectedIndex="0">
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="="/>
                                <ComboBoxItem Content=">"/>
                                <ComboBoxItem Content=">="/>
                                <ComboBoxItem Content="&lt;"/>
                                <ComboBoxItem Content="&lt;="/>
                    </ComboBox>
                    <TextBox x:Name="AgeValue"
                                Width="150"
                                Height="40"
                                Margin="100,-45,5,5"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                TextChanged="BatchFilterSelected"/>
                </StackPanel>
            </Grid>
        </Expander>

        <!-- Students DataGrid -->
        <DataGrid x:Name="StudentsGrid" 
                  Grid.Row="2"
                  Margin="10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" 
                                  Binding="{Binding Name}" 
                                  Width="Auto">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Name"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Age" 
                                  Binding="{Binding Age}" 
                                  Width="60">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Age"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Gender" 
                                  Binding="{Binding Gender}" 
                                  Width="80">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Gender"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Location" 
                                  Binding="{Binding Location}" 
                                  Width="*">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Location"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Belt" 
                                  Binding="{Binding Belt}" 
                                  Width="100">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Belt"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Instructor" 
                                  Binding="{Binding InstructorName}" 
                                  Width="*">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Instructor"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Master" 
                                  Binding="{Binding MasterName}" 
                                  Width="*">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Master"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Status" 
                                  Binding="{Binding StudentStatus}" 
                                  Width="80">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Status"
                                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Due For Exam" 
                  Binding="{Binding ExamDue}" 
                  Width="*">
                    <DataGridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <ContentControl Content="Due For Exam"
                          ContentTemplate="{StaticResource DataGridFilterHeaderTemplate}"/>
                        </DataTemplate>
                    </DataGridTextColumn.HeaderTemplate>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="Add New Student"
                    Click="BtnAddStudent_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="View Details"
                    Click="BtnViewDetails_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="Attendance"
                    Click="BtnViewAttendance_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button Content="Update Status"
                    Click="BtnUpdateStatus_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"/>
            <Button x:Name="BtnDeleteStudent"
                    Content="Delete Student"
                    Click="BtnDeleteStudent_Click"
                    Style="{StaticResource ModernButtonStyle}"
                    Margin="0,0,10,0"
                    Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>