<Window x:Class="Zenskar_MAMS.Windows.Attendance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Zenskar_MAMS.Windows"
        mc:Ignorable="d"
        Title="Attendance" Height="540" Width="744"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Height="535" >
        <!-- Header -->
        <StackPanel Grid.Row="0"  
            Background="{StaticResource PrimaryBackgroundBrush}" Margin="0,15,0,74">
            <TextBlock Text="Student's Attendance"
              Foreground="{StaticResource TextPrimaryBrush}"
              FontSize="24"
              Margin="30,10" Width="584"/>
            <Button x:Name="BtnBack"
            Content="Back"
            Click="BtnBack_Click"
            Margin="400,-40,20,10"
            Style="{StaticResource ModernButtonStyle}" Width="100"/>
        </StackPanel>
        <Expander VerticalAlignment="Center" HorizontalAlignment="Center"
          Header="Select Month" Foreground="{StaticResource TextSecondaryBrush}"
          IsExpanded="True" Height="226" Width="481">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="172*"/>
                    <ColumnDefinition Width="62*"/>
                    <ColumnDefinition Width="165*"/>
                    <ColumnDefinition Width="0*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Row 1 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5,5,5,5" Grid.ColumnSpan="2">
                    <TextBlock Text="Month"
                                FontSize="15"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,0,0,-25" />
                    <ComboBox x:Name="Month" Width="254"
                                Foreground="{StaticResource SecondaryBackgroundBrush}"                    
                                SelectedIndex="0" SelectionChanged="RefreshMonthData_Click">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="January"/>
                        <ComboBoxItem Content="February"/>
                        <ComboBoxItem Content="March"/>
                        <ComboBoxItem Content="April"/>
                        <ComboBoxItem Content="May"/>
                        <ComboBoxItem Content="June"/>
                        <ComboBoxItem Content="July"/>
                        <ComboBoxItem Content="August"/>
                        <ComboBoxItem Content="September"/>
                        <ComboBoxItem Content="October"/>
                        <ComboBoxItem Content="November"/>
                        <ComboBoxItem Content="December"/>
                    </ComboBox>
                </StackPanel>
                <!-- YearDisplay -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5,5,5,5">
                    <TextBlock Text="Year:"
                             Style="{StaticResource ModernLabelStyle}"/>
                    <TextBlock x:Name="TxtYearDisplay"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="30"
                               Height="40"
                             Margin="55,-25,5,5"/>
                </StackPanel>
                <!-- AttendedClasses -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,5,5,5" Grid.ColumnSpan="2">
                    <TextBlock Text="No of Classes Attended:"
                         Style="{StaticResource ModernLabelStyle}" />
                    <TextBlock x:Name="AttendedClassesDisplay" 
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="30"
                                Height="40"
                                Margin="165,-25,5,5"
                               MouseLeftButtonDown="UpdateNoofClassesAttended" Cursor="Hand"/>
                </StackPanel>
                <!-- TotalClasses -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="5,5,5,5">
                    <TextBlock Text="Total No of Classes:"
             Style="{StaticResource ModernLabelStyle}"/>
                    <TextBlock x:Name="TotalClassesDisplay"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="30"
                                Height="40"
                                Margin="150,-25,5,5"
                               MouseLeftButtonDown="UpdateTotalNoofClasses" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Expander>
    </Grid>
</Window>
