<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.RequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Zenskar_MAMS.Windows"
        Title="Requests - Zenskar MAMS" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SecondaryBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" 
            Background="{StaticResource PrimaryBackgroundBrush}"
            Margin="0">
            <TextBlock Text="Requests Management"
              Foreground="{StaticResource TextPrimaryBrush}"
              FontSize="24"
              Margin="30,10"/>
            <Button x:Name="BtnBack"
                Content="Back"
                Click="BtnBack_Click"
                Margin="650,-40,20,10"
                Style="{StaticResource ModernButtonStyle}" Width="100"/>
            <Button x:Name="BtnRefresh"
                Content="Refresh"
                Click="BtnRefresh_Click"
                Margin="400,-40,20,10"
                Style="{StaticResource ModernButtonStyle}" Width="100"/>
            <Button x:Name="BtnLogout"
                Content="Logout"
                Click="BtnLogout_Click"
                Margin="400,-40,20,10"
                Style="{StaticResource LogoutButtonStyle}"/>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal"
                    Margin="20,15">
            <TextBlock Text="Status:"
                      VerticalAlignment="Center"
                      Style="{StaticResource ModernLabelStyle}"
                      Margin="0,0,10,0"/>
            <CheckBox x:Name="ChkOpen" Foreground="{StaticResource TextSecondaryBrush}"
                     Content="Open" 
                     IsChecked="True"
                     Margin="0,0,10,0"
                     Checked="FilterCheckBox_Changed"
                     Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="ChkApproved" Foreground="{StaticResource TextSecondaryBrush}"
                     Content="Approved"
                     Margin="0,0,10,0"
                     Checked="FilterCheckBox_Changed"
                     Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="ChkRejected" Foreground="{StaticResource TextSecondaryBrush}"
                     Content="Rejected"
                     Margin="0,0,10,0"
                     Checked="FilterCheckBox_Changed"
                     Unchecked="FilterCheckBox_Changed"/>
            
            <TextBlock Text="Type:"
                      VerticalAlignment="Center"
                      Style="{StaticResource ModernLabelStyle}"
                      Margin="20,0,10,0"/>
            <CheckBox x:Name="ChkRegistration" Foreground="{StaticResource TextSecondaryBrush}"
                     Content="Registration" 
                     IsChecked="True"
                     Margin="0,0,10,0"
                     Checked="FilterCheckBox_Changed"
                     Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="ChkUpdate" Foreground="{StaticResource TextSecondaryBrush}"
                     Content="Update"
                     IsChecked="True"
                     Margin="0,0,10,0"
                     Checked="FilterCheckBox_Changed"
                     Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="ChkDelete" Foreground="{StaticResource TextSecondaryBrush}"
                     Content="Delete"
                     IsChecked="True"
                     Margin="0,0,10,0"
                     Checked="FilterCheckBox_Changed"
                     Unchecked="FilterCheckBox_Changed"/>
        </StackPanel>

        <!-- Requests DataGrid -->
        <DataGrid x:Name="RequestsGrid" 
                  Grid.Row="2"
                  Margin="20"
                  Style="{StaticResource ModernDataGridStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="RequestsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Request ID" 
                                  Binding="{Binding Request_ID}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Type" 
                                  Binding="{Binding RequestType}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Requested By" 
                                  Binding="{Binding RequestedBy}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Student" 
                                  Binding="{Binding StudentName}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Status" 
                                  Binding="{Binding Status}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Requested Date" 
                                  Binding="{Binding RequestedDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Approved By" 
                                  Binding="{Binding ApprovedBy}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Rejected Reason" 
                                  Binding="{Binding RejectedReason}" 
                                  Width="*"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="MenuItemApprove"
                             Click="MenuItemApprove_Click">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="Approve Request"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequestType}" Value="Update">
                                        <Setter Property="Header" Value="View Update"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem x:Name="MenuItemReject"
                            Header="Reject Request"
                            Click="MenuItemReject_Click"/>
                    <MenuItem Header="View Details"
                            Click="MenuItemViewDetails_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRowStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                            <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                            <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Open">
                            <Setter Property="Background" Value="{StaticResource WarningBrush1}"/>
                            <Setter Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Window>