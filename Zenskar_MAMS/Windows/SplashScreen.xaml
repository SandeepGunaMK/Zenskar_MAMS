<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zenskar MAMS" 
        Height="450" 
        Width="800"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Storyboard x:Key="LoadingAnimation">
            <DoubleAnimation 
                Storyboard.TargetName="ProgressBar"
                Storyboard.TargetProperty="Value"
                From="0" To="100" Duration="0:0:3"/>
        </Storyboard>
    </Window.Resources>
    
    <Border CornerRadius="20" 
            Background="{StaticResource PrimaryBackgroundBrush}"
            BorderThickness="1"
           >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title with Gradient -->
            <StackPanel Grid.Row="1" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <TextBlock Text="ZENSKAR"
                         FontSize="64"
                         FontWeight="Bold"
                         HorizontalAlignment="Center">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                            <GradientStop Color="{StaticResource AccentPurple}" Offset="0.5"/>
                            <GradientStop Color="{StaticResource AccentPink}" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="30" 
                                        ShadowDepth="0" 
                                        Color="{StaticResource AccentBlue}"
                                        Opacity="0.5"/>
                    </TextBlock.Effect>
                </TextBlock>

                <TextBlock Text="Martial Arts Management System"
                         Foreground="{StaticResource TextSecondaryBrush}"
                         FontSize="20"
                         HorizontalAlignment="Center"
                         Margin="0,10,0,30"/>

                <!-- Progress Bar -->
                <ProgressBar x:Name="ProgressBar"
                           Width="300"
                           Height="4"
                           Maximum="100"
                           Value="0">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="{StaticResource SurfaceBrush}"
                                                    CornerRadius="2"/>
                                            <Border x:Name="PART_Track"
                                                    CornerRadius="2">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                                                        <GradientStop Color="{StaticResource AccentPurple}" Offset="0.5"/>
                                                        <GradientStop Color="{StaticResource AccentPink}" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
        </Grid>
    </Border>
</Window>