<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.RequestDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Request Details" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource PrimaryBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="Student Update Request Details"
                 Style="{StaticResource ModernHeaderStyle}"
                 Margin="0,0,0,20"/>

        <!-- Comparison Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Current Values -->
            <Border Grid.Column="0" 
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock Text="Current Values"
                             DockPanel.Dock="Top"
                             Style="{StaticResource ModernHeaderStyle}"
                             FontSize="18"
                             Margin="15,15,15,5"/>
                    
                    <ScrollViewer Margin="15,5,15,15">
                        <StackPanel x:Name="CurrentValuesPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Requested Changes -->
            <Border Grid.Column="1" 
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="8"
                    Margin="10,0,0,0">
                <DockPanel>
                    <TextBlock Text="Requested Changes"
                             DockPanel.Dock="Top"
                             Style="{StaticResource ModernHeaderStyle}"
                             FontSize="18"
                             Margin="15,15,15,5"/>
                    
                    <ScrollViewer Margin="15,5,15,15">
                        <StackPanel x:Name="RequestedValuesPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="Approve"
                    x:Name="BtnApprove"
                    Click="BtnApprove_Click"
                    Width="120"
                    Margin="0,0,10,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource SuccessColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AccentBlue}" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            
            <Button Content="Reject"
                    x:Name="BtnReject"
                    Click="BtnReject_Click"
                    Width="120"
                    Margin="0,0,10,0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource ErrorColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AccentPink}" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
            </Button>
            
            <Button Content="Close"
                    Click="BtnClose_Click"
                    Width="120"/>
        </StackPanel>
    </Grid>
</Window>