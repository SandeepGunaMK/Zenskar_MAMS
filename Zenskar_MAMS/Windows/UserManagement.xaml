<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.UserManagement"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Management - Zenskar MAMS" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SecondaryBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" 
             Background="{StaticResource PrimaryBackgroundBrush}"
             Margin="0">
            <TextBlock Text="User Management"
               Foreground="{StaticResource TextPrimaryBrush}"
               FontSize="24"
               Margin="30,10"/>
            <Button x:Name="BtnBack"
             Content="Back"
             Click="BtnBack_Click"
             Margin="800,-40,20,10"
             Style="{StaticResource ModernButtonStyle}" Width="30"/>
        </StackPanel>

        <!-- Filters -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal"
                    Margin="10">
            <TextBlock Text="User Type:"
                       Foreground="{StaticResource TextPrimaryBrush}"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbUserTypeFilter" 
                      Foreground="{StaticResource TextPrimaryBrush}"
                     Width="120"
                     Margin="0,0,20,0"
                     SelectionChanged="CmbUserTypeFilter_SelectionChanged">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Master"/>
                <ComboBoxItem Content="Instructor"/>
            </ComboBox>

            <TextBlock Text="Status:"
                       Foreground="{StaticResource TextPrimaryBrush}"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbStatusFilter" 
                     Width="120"
                     SelectionChanged="CmbStatusFilter_SelectionChanged">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Active"/>
                <ComboBoxItem Content="Inactive"/>
                <ComboBoxItem Content="Pending Approval"/>
            </ComboBox>
        </StackPanel>

        <!-- Users DataGrid -->
        <DataGrid x:Name="UsersGrid" 
                  Grid.Row="2"
                  Margin="10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="UsersGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Login ID" 
                                  Binding="{Binding login_ID}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Name" 
                                  Binding="{Binding User_Name}" 
                                  Width="*"/>
                <DataGridTextColumn Header="Contact Number" 
                                  Binding="{Binding Contact_Number}" 
                                  Width="120"/>
                <DataGridTextColumn Header="User Type" 
                                  Binding="{Binding User_Type}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Status" 
                                  Binding="{Binding Status}" 
                                  Width="120"/>
                <DataGridTextColumn Header="Created Date" 
                                  Binding="{Binding Created_Date, StringFormat={}{0:dd/MM/yyyy}}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Approved By" 
                                  Binding="{Binding Approved_By}" 
                                  Width="150"/>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="View Details"
                            Click="MenuItemViewDetails_Click"/>
                    <MenuItem Header="Change Status"
                            Click="MenuItemChangeStatus_Click"/>
                    <MenuItem Header="Reset Password"
                            Click="MenuItemResetPassword_Click"/>
                    <MenuItem Header="Delete User"
                            Click="MenuItemDelete_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</Window>