<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zenskar_MAMS.Windows.MasterHome"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Master Home - Zenskar MAMS" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SecondaryBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        
        <StackPanel Grid.Row="0" 
                    Background="{StaticResource PrimaryBackgroundBrush}"
                    Margin="10,10,18,10">
            <TextBlock Text="Master Dashboard"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      FontSize="24"
                      Margin="20,0" Width="199"/>
            <Button x:Name="BtnLogout"
                     Content="Logout"
                     Click="BtnLogout_Click"
                     Margin="500,-25,15,10"
                     Style="{StaticResource LogoutButtonStyle}"/>
            <Button x:Name="BtnChangePassword"
                    Content="Change Password"
                    Click="BtnChangePassword_Click"
                    Margin="-600,-50,10,0"
                    Height="30"
                    Width="120"
                    Style="{StaticResource ModernButtonStyle}"/>
        </StackPanel>
        

        <!-- Dashboard Cards -->
        <WrapPanel Grid.Row="1" 
          HorizontalAlignment="Center"
          Margin="0,20">

            <!-- Students List Card -->
            <Border Width="300" 
            Height="200"
            Margin="15"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                            ShadowDepth="0"
                            Color="{StaticResource AccentBlue}"
                            Opacity="0.2"/>
                </Border.Effect>
                <Button Style="{StaticResource ModernButtonStyle}"
                Click="BtnStudentsList_Click"
                Background="Transparent"
                Width="300"
                Height="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Path Grid.Row="0"
                      Data="M12,5A3.5,3.5 0 0,0 8.5,8.5A3.5,3.5 0 0,0 12,12A3.5,3.5 0 0,0 15.5,8.5A3.5,3.5 0 0,0 12,5M12,7A1.5,1.5 0 0,1 13.5,8.5A1.5,1.5 0 0,1 12,10A1.5,1.5 0 0,1 10.5,8.5A1.5,1.5 0 0,1 12,7M5.5,8A2.5,2.5 0 0,0 3,10.5C3,11.44 3.53,12.25 4.29,12.68C4.65,12.88 5.06,13 5.5,13C5.94,13 6.35,12.88 6.71,12.68C7.47,12.25 8,11.44 8,10.5A2.5,2.5 0 0,0 5.5,8M19,2H5C3.89,2 3,2.89 3,4V18A2,2 0 0,0 5,20H9L12,23L15,20H19A2,2 0 0,0 21,18V4C21,2.89 20.1,2 19,2Z"
                      Width="50"
                      Height="50"
                      Fill="{StaticResource AccentGradientBrush}"
                      Stretch="Uniform"
                      Margin="0,20"/>

                        <!-- Text -->
                        <StackPanel Grid.Row="1"
                          VerticalAlignment="Center">
                            <TextBlock Text="Students List"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             HorizontalAlignment="Center"/>
                            <TextBlock Text="Manage student records"
                             FontSize="14"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,5"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>

            <!-- Requests Card -->
            <Border Width="300" 
            Height="200"
            Margin="15"
            Background="{StaticResource SurfaceBrush}"
            CornerRadius="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" 
                            ShadowDepth="0"
                            Color="{StaticResource AccentPurple}"
                            Opacity="0.2"/>
                </Border.Effect>
                <Button Style="{StaticResource ModernButtonStyle}"
                Click="BtnRequests_Click"
                Background="Transparent"
                Width="300"
                Height="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Icon -->
                        <Path Grid.Row="0"
                      Data="M21,11C21,16.55 17.16,21.74 12,23C6.84,21.74 3,16.55 3,11V5L12,1L21,5V11M12,21C15.75,20 19,15.54 19,11.22V6.3L12,3.18L5,6.3V11.22C5,15.54 8.25,20 12,21Z"
                      Width="50"
                      Height="50"
                      Fill="{StaticResource PrimaryGradientBrush}"
                      Stretch="Uniform"
                      Margin="0,20"/>

                        <!-- Text -->
                        <StackPanel Grid.Row="1"
                          VerticalAlignment="Center">
                            <TextBlock Text="Requests"
                             FontSize="24"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             HorizontalAlignment="Center"/>
                            <TextBlock Text="Manage pending requests"
                             FontSize="14"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             HorizontalAlignment="Center"
                             Margin="0,5"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>
        </WrapPanel>
    </Grid>
</Window>